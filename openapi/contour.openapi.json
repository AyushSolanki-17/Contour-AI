          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health state returned by the HTTP delivery adapter.",
        "properties": {
          "status": {
            "enum": [
              "live",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SourceCreateRequest": {
        "description": "Source-neutral registration payload for one logical source.",
