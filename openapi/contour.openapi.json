          "canonical_locator": {
            "minLength": 1,
            "title": "Canonical Locator",
            "type": "string"
          },
          "connector_kind": {
            "minLength": 1,
            "title": "Connector Kind",
            "type": "string"
          },
          "data_classification": {
            "minLength": 1,
            "title": "Data Classification",
            "type": "string"
