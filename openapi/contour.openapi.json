{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "A safe machine-readable error exposed to API clients.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "One safe field-level reason that an API request was rejected.",
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The common HTTP error envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health state returned by the HTTP delivery adapter.",
        "properties": {
          "status": {
            "enum": [
              "live",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SourcePutRequest": {
        "additionalProperties": false,
        "description": "Source-neutral logical-source registration representation.",
        "properties": {
          "canonical_locator": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Canonical Locator",
            "type": "string"
          },
          "data_classification": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Data Classification",
            "type": "string"
          },
          "license": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "scope": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Scope",
            "type": "string"
          },
          "source_type": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "title": "Source Type",
            "type": "string"
          }
        },
        "required": [
          "source_type",
          "canonical_locator",
          "scope",
          "data_classification"
        ],
        "title": "SourcePutRequest",
        "type": "object"
      },
      "SourceResponse": {
        "description": "Canonical public representation of one registered logical source.",
        "properties": {
          "canonical_locator": {
            "title": "Canonical Locator",
            "type": "string"
          },
          "data_classification": {
            "title": "Data Classification",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          },
          "workspace_id": {
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "source_type",
          "canonical_locator",
          "scope",
          "license",
          "data_classification"
        ],
        "title": "SourceResponse",
        "type": "object"
      },
      "WorkspacePutRequest": {
        "additionalProperties": false,
        "description": "Representation accepted when creating a trusted-local workspace.",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "WorkspacePutRequest",
        "type": "object"
      },
      "WorkspaceResponse": {
        "description": "Canonical public representation of one workspace.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "owner": {
            "title": "Owner",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "owner"
        ],
        "title": "WorkspaceResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Contour",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/workspaces/{workspace_id}": {
      "get": {
        "description": "Return an accepted workspace by canonical identity.",
        "operationId": "get_workspace_api_v1_workspaces__workspace_id__get",
        "parameters": [
          {
            "description": "Canonical workspace identifier",
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "description": "Canonical workspace identifier",
              "maxLength": 255,
              "minLength": 3,
              "pattern": "^WORKSPACE:[A-Za-z0-9._~-]+$",
              "title": "Workspace Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Resource not found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Required dependency unavailable"
          }
        },
        "summary": "Get Workspace",
        "tags": [
          "catalog"
        ]
      },
      "put": {
        "description": "Create a workspace or return its exact accepted replay.",
        "operationId": "put_workspace_api_v1_workspaces__workspace_id__put",
        "parameters": [
          {
            "description": "Canonical workspace identifier",
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "description": "Canonical workspace identifier",
              "maxLength": 255,
              "minLength": 3,
              "pattern": "^WORKSPACE:[A-Za-z0-9._~-]+$",
              "title": "Workspace Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspacePutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Identity conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Required dependency unavailable"
          }
        },
        "summary": "Put Workspace",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/workspaces/{workspace_id}/sources/{source_id}": {
      "get": {
        "description": "Return a source only through its owning workspace path.",
        "operationId": "get_source_api_v1_workspaces__workspace_id__sources__source_id__get",
        "parameters": [
          {
            "description": "Canonical workspace identifier",
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "description": "Canonical workspace identifier",
              "maxLength": 255,
              "minLength": 3,
              "pattern": "^WORKSPACE:[A-Za-z0-9._~-]+$",
              "title": "Workspace Id",
              "type": "string"
            }
          },
          {
            "description": "Canonical source identifier",
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "description": "Canonical source identifier",
              "maxLength": 255,
              "minLength": 3,
              "pattern": "^SOURCE(?::[A-Z][A-Z0-9_-]*)*:[A-Za-z0-9._~-]+$",
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Resource not found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Required dependency unavailable"
          }
        },
        "summary": "Get Source",
        "tags": [
          "catalog"
        ]
      },
      "put": {
        "description": "Register a supported logical source or return its exact replay.",
        "operationId": "put_source_api_v1_workspaces__workspace_id__sources__source_id__put",
        "parameters": [
          {
            "description": "Canonical workspace identifier",
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "description": "Canonical workspace identifier",
              "maxLength": 255,
              "minLength": 3,
              "pattern": "^WORKSPACE:[A-Za-z0-9._~-]+$",
              "title": "Workspace Id",
              "type": "string"
            }
          },
          {
            "description": "Canonical source identifier",
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "description": "Canonical source identifier",
              "maxLength": 255,
              "minLength": 3,
              "pattern": "^SOURCE(?::[A-Z][A-Z0-9_-]*)*:[A-Za-z0-9._~-]+$",
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourcePutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Resource not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Identity conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported source"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Required dependency unavailable"
          }
        },
        "summary": "Put Source",
        "tags": [
          "catalog"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Return process liveness without checking external dependencies.\n\nReturns:\n    HTTP response model reporting the live state.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Return readiness after checking required dependencies.\n\nReturns:\n    HTTP response model reporting the ready state.\n\nRaises:\n    DependencyUnavailableError: Translated globally into HTTP 503.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
